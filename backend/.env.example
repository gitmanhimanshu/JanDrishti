# ---------------------------------------------------------------------------
# JanDrishti backend environment.  Copy to .env and fill in.  NEVER commit .env
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-in-production-use-a-50-char-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL.  Leave unset in local development to fall back to SQLite.
DATABASE_URL=postgres://jandrishti:jandrishti@localhost:5432/jandrishti

# Redis: cache, rate limiting, Celery broker.  Unset -> in-memory locmem cache.
REDIS_URL=redis://localhost:6379/0

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# JWT
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30

# Cloudinary.  Unset -> the local filesystem media adapter is used instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI provider (optional; unset -> heuristic NullAIService)
AI_PROVIDER=null
AI_API_KEY=

# Funding: real money movement stays OFF until the legal/payment architecture
# described in docs/decisions/funding.md is actually in place.
FUNDING_PAYMENTS_ENABLED=False
